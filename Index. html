<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kay 0.1</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#07111f;
  color:white;
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
}

.app{
  width:100%;
  max-width:480px;
  min-height:100vh;
  padding:20px;
  background:linear-gradient(180deg,#0b1b30,#07111f);
  display:flex;
  flex-direction:column;
}

.header{
  text-align:center;
  padding:20px 10px;
}

.avatar{
  width:105px;
  height:105px;
  margin:auto;
  border-radius:50%;
  background:linear-gradient(135deg,#d96b3b,#8f3f27);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:55px;
  box-shadow:0 0 30px #2ad4ff55;
}

h1{
  margin-top:12px;
  font-size:30px;
}

.subtitle{
  color:#9edff5;
  margin-top:5px;
}

.chat{
  flex:1;
  margin-top:20px;
  padding:15px;
  border-radius:20px;
  background:#102238;
  overflow:auto;
}

.message{
  padding:12px 15px;
  margin:10px 0;
  border-radius:16px;
  line-height:1.4;
}

.kay{
  background:#183b52;
  border-bottom-left-radius:4px;
}

.user{
  background:#713f58;
  border-bottom-right-radius:4px;
  text-align:right;
}

.input-area{
  display:flex;
  gap:8px;
  margin-top:15px;
}

input{
  flex:1;
  padding:14px;
  border:none;
  border-radius:15px;
  outline:none;
  font-size:16px;
}

button{
  border:none;
  border-radius:15px;
  padding:12px 16px;
  font-weight:bold;
  cursor:pointer;
}

.send{
  background:#55d6ff;
  color:#07111f;
}

.memory{
  margin-top:10px;
  display:flex;
  gap:8px;
}

.memory button{
  flex:1;
  background:#263b52;
  color:white;
}

.status{
  text-align:center;
  color:#7dd9a8;
  font-size:13px;
  margin-top:12px;
}
</style>
</head>

<body>

<div class="app">

  <div class="header">
    <div class="avatar">👨🏽‍💻</div>
    <h1>Kay</h1>
    <div class="subtitle">Tu asistente • Prototipo 0.1</div>
  </div>

  <div class="chat" id="chat">

    <div class="message kay">
      ¡Holaaa! 👋 Soy Kay.  
      Este es mi primer prototipo. Estoy listo para aprender y crecer contigo. 🚀
    </div>

  </div>

  <div class="input-area">
    <input
      id="mensaje"
      type="text"
      placeholder="Escribe algo a Kay..."
      onkeydown="if(event.key==='Enter') enviar()"
    >
    <button class="send" onclick="enviar()">Enviar</button>
  </div>

  <div class="memory">
    <button onclick="guardarMemoria()">💾 Guardar</button>
    <button onclick="olvidarMemoria()">🧠 Olvidar</button>
  </div>

  <div class="status" id="estado">
    ● Kay está listo
  </div>

</div>

<script>

function enviar(){

  const input = document.getElementById("mensaje");
  const texto = input.value.trim();

  if(texto === "") return;

  const chat = document.getElementById("chat");

  const usuario = document.createElement("div");
  usuario.className = "message user";
  usuario.textContent = texto;

  chat.appendChild(usuario);

  input.value = "";

  setTimeout(() => {

    const respuesta = document.createElement("div");
    respuesta.className = "message kay";

    respuesta.textContent =
      "Te escucho 👀. Todavía soy un prototipo, pero poco a poco vamos a convertir a Kay en algo mucho más completo.";

    chat.appendChild(respuesta);

    chat.scrollTop = chat.scrollHeight;

  },500);
}


function guardarMemoria(){

  localStorage.setItem(
    "kay_memoria",
    "El usuario permitió guardar una memoria."
  );

  document.getElementById("estado").textContent =
    "● Memoria guardada";
}


function olvidarMemoria(){

  localStorage.removeItem("kay_memoria");

  document.getElementById("estado").textContent =
    "● Memoria eliminada";
}

</script>

</body>
</html>
